{
  "name": "@hanzo/agents",
  "version": "0.2.9",
  "description": "Hanzo Agents TypeScript SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/cohere": "catalog:",
    "@ai-sdk/deepseek": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/groq": "catalog:",
    "@ai-sdk/mistral": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/xai": "catalog:",
    "ai": "catalog:",
    "axios": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "ts-node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/agents.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/hanzoai/agents/tree/main/sdk/typescript",
  "bugs": {
    "url": "https://github.com/hanzoai/agents/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "hanzo-agents",
    "ai-agents",
    "llm",
    "multi-agent",
    "orchestration"
  ],
  "author": "Hanzo Agents Team",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
