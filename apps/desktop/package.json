{
  "name": "desktop",
  "version": "1.5.0",
  "description": "Hanzo Agents Desktop App",
  "license": "Apache-2.0",
  "author": "Hanzo AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/agents.git",
    "directory": "apps/desktop"
  },
  "type": "commonjs",
  "main": "dist/main/src/main/main.js",
  "scripts": {
    "postinstall": "electron-rebuild",
    "start": "npm run build && npm run build:main && electron .",
    "build": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dev": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "dev:mcp": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --mcp\"",
    "electron": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack": "npm run build && npm run build:main && node scripts/prepare-build.js && electron-builder --dir --config electron-builder.config.js",
    "dist": "npm run build && npm run build:main && node scripts/prepare-build.js && electron-builder --config electron-builder.config.js",
    "dist:full": "node scripts/build-dist.js"
  },
  "devDependencies": {
    "@electron/get": "catalog:",
    "@electron/notarize": "catalog:",
    "@electron/rebuild": "catalog:",
    "extract-zip": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "husky": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-electron": "catalog:",
    "vitest": "catalog:",
    "wait-on": "catalog:"
  },
  "dependencies": {
    "@hanzo/agents-shared": "workspace:*",
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@paper-design/shaders-react": "catalog:",
    "@types/sqlite3": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/addon-webgl": "catalog:",
    "@xterm/xterm": "catalog:",
    "@xyflow/react": "catalog:",
    "ai": "catalog:",
    "keytar": "catalog:",
    "marked": "catalog:",
    "node-pty": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "sqlite3": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  }
}
