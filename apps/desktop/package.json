{
  "name": "desktop",
  "version": "1.5.0",
  "description": "Hanzo Agents Desktop App",
  "license": "Apache-2.0",
  "author": "Hanzo AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/agents.git",
    "directory": "apps/desktop"
  },
  "type": "commonjs",
  "main": "dist/main/src/main/main.js",
  "scripts": {
    "postinstall": "electron-rebuild",
    "start": "npm run build && npm run build:main && electron .",
    "build": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dev": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "dev:mcp": "npm run build:main && concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --mcp\"",
    "electron": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack": "npm run build && npm run build:main && node scripts/prepare-build.js && electron-builder --dir --config electron-builder.config.js",
    "dist": "npm run build && npm run build:main && node scripts/prepare-build.js && electron-builder --config electron-builder.config.js",
    "dist:full": "node scripts/build-dist.js"
  },
  "devDependencies": {
    "@electron/get": "^5.1.0",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "extract-zip": "^2.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@hanzo/agents-shared": "*",
    "@ai-sdk/anthropic": "^4.0.45",
    "@ai-sdk/google": "^4.0.57",
    "@ai-sdk/openai": "^4.0.51",
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@paper-design/shaders-react": "^0.0.80",
    "@types/sqlite3": "^5.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.5",
    "ai": "^7.0.84",
    "keytar": "^7.9.0",
    "marked": "^18.0.11",
    "node-pty": "^1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.5.2",
    "zustand": "^5.0.15"
  }
}
