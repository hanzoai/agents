{
  "name": "@hanzo/agents-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Hanzo Agents - Multi-agent orchestration platform",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/agents.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules sdk/typescript/node_modules apps/*/dist packages/*/dist apps/*/release",
    "dev:desktop": "pnpm --filter @hanzo/agents-shared build && pnpm --filter desktop dev",
    "dev:mcp": "pnpm --filter @hanzo/agents-shared build && pnpm --filter desktop dev:mcp"
  },
  "overrides": {
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
